# Copy to .env and fill in per machine. All of these are optional -- unset
# falls back to the default already in src/config.py, so local dev needs none
# of this. This file exists for deploy targets (e.g. the Suricata VM) that
# need different paths than the dev machine without editing tracked source.

# Path to the trained model artifact (models/detector.joblib by default).
# MODEL_PATH=/opt/ai-ids/models/detector.joblib

# Path to a live/growing Suricata eve.json. When set, `python -m
# src.detector.suricata_reader` with no flags will tail it (CLI --eve still
# overrides this if passed explicitly).
# EVE_PATH=/var/log/suricata/eve.json

# Where scored incidents get appended as JSON Lines. Also the path
# promtail.yaml's ai_incidents scrape job should point at.
# INCIDENTS_PATH=/var/log/ai-ids/incidents.jsonl

# "ollama" (default) or "template". Use "template" on machines without Ollama
# installed/running (e.g. the Suricata VM) to skip the fallback attempt.
# REPORT_BACKEND=template

# Only relevant when REPORT_BACKEND=ollama. The ollama Python package reads
# this natively; it does not need src/config.py to do anything extra.
# OLLAMA_HOST=http://localhost:11434
